{
  "expo": {
    "name": "Netora",
    "slug": "netora",
    "version": "1.0.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "netora",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.netora.networkutility",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101722"
      },
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8665718760035175~4475702095"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Netora to show the current Wi-Fi name and BSSID. Speed tests, mobile data diagnostics, public IP lookup, and server mapping work without this permission."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 1242,
          "resizeMode": "contain",
          "backgroundColor": "#101722",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#101722"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d8f93be-a872-4334-a509-beeae02a412b"
      }
    },
    "owner": "xyteeee"
  }
}
